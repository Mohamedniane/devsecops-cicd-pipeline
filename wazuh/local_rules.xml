<group name="local,nmap,recon,ufw,">
  <!--
    Regle 100000 : detecte UFW BLOCK individuels
    Cascade obligatoire sur la regle 4100 (Firewall rules grouped)
    qui intercepte silencieusement les logs UFW au level 0.
  -->
  <rule id="100000" level="5">
    <if_sid>4100</if_sid>
    <match>UFW BLOCK</match>
    <description>UFW: packet blocked from $(srcip) to port $(dstport)</description>
    <group>firewall,ufw,</group>
  </rule>
  <!--
    Regle 100001 : detecte scan reseau (nmap)
    Composite : 10 evenements 100000 en 30s
    depuis la meme IP source.
    Enrichissement MITRE ATT&CK T1046
  -->
  <rule id="100001" level="10" frequency="10" timeframe="30">
    <if_matched_sid>100000</if_matched_sid>
    <same_source_ip />
    <description>nmap scan detected: multiple ports probed from $(srcip)</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>recon,attack,pci_dss_11.4,gdpr_IV_35.7.d,</group>
  </rule>
</group>
